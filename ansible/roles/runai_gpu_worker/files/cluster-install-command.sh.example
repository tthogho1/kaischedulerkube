#!/usr/bin/env bash
# Paste the install command issued by the Run:ai control-plane UI's
# "New Cluster" wizard here, then rename this file to
# cluster-install-command.sh.
# Example (actual values differ per tenant):
#
# helm upgrade -i runai-cluster runai/runai-cluster \
#   --namespace runai --create-namespace \
#   --set controlPlane.url=https://runai.example.com \
#   --set controlPlane.clusterUUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx \
#   --set controlPlane.token=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
set -euo pipefail
echo "Replace cluster-install-command.sh with the actual Run:ai command" >&2
exit 1
