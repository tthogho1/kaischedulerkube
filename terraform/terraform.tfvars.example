# Copy to terraform.tfvars and edit the values: cp terraform.tfvars.example terraform.tfvars

aws_region          = "ap-northeast-1"
project_name        = "kai-k8s"
ssh_allowed_cidr    = "203.0.113.10/32" # Change to your own global IP/32 (check with: curl ifconfig.me)
public_key_path     = "~/.ssh/id_rsa.pub"

control_plane_instance_type = "t3.large"
gpu_worker_instance_type    = "g4dn.xlarge"
gpu_worker_count            = 1
